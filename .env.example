# Copy to .env for local development. Never commit .env.
DEBUG=true
SECRET_KEY=dev-insecure-change-me
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://opsapps:opsapps@localhost:5432/opsapps
# CSRF_TRUSTED_ORIGINS=https://opsapps.example.com
# TIME_ZONE=America/New_York
# MEDIA_ROOT=/var/lib/opsapps/media
# REFUND_APPROVAL_LIMIT=1000
# REFUND_CURRENCY=USD
# AUDIT_RETENTION_DAYS=365
# AUDIT_PROXY_COUNT=1          # behind Azure Front Door / App Service
# AUDIT_API_ACCESS=true
# SESSION_COOKIE_AGE=7200      # idle timeout, seconds
# LOGIN_LOCKOUT_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# Integrations: each ExternalSystem names the env var holding its Entra client secret.
# CRM_PROD_CLIENT_SECRET=...
# ENTRA_AUTHORITY_HOST=https://login.microsoftonline.com
# INTEGRATIONS_HTTP_RETRIES=3
